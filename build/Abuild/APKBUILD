pkgname=pixman
pkgver=0.46.4
pkgrel=4
pkgdesc="Image processing and manipulation library"
arch="all"
license="MIT"
url="https://gitlab.freedesktop.org/pixman/pixman/"
makedepends="libpng-dev meson ninja pkgconf pkgconf-dev"
depends="libpng"
makedepends="clang meson"
#options="!check" # all pass but it took way too long on rpi4/5
subpackages="${pkgname}-static ${pkgname}-dev"
source="https://cairographics.org/releases/${pkgname}-${pkgver}.tar.xz"

build() {
    CC="clang" \
    CXX="clang++" \
    # We need to increase the stacksize here: https://gitlab.gnome.org/GNOME/librsvg/-/issues/595
    LDFLAGS="$LDFLAGS -Wl,-z,stack-size=2097152" \
    # auto-features=auto: a lot of features are architecture dependent
    abuild-meson \
        -Dc_link_args="-Wl,-lm" \
	-Dc_args="-O2" \
	--auto-features=auto \
        -Dtests=enabled \
        -Dopenmp=disabled \
        -Ddefault_library=both \
        -Ddemos=disabled \
	. build

    ninja -C build
}

check() {
    meson test -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
}


sha512sums="
